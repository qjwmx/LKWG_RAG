# 复制为 backend/.env 后按需修改。所有项都有可用默认值，因此 .env 可以不存在。

# --------------------------------------------------------------------------- 数据库
# 默认 SQLite，落在 backend/data/rag.db。默认值是**绝对路径**，不受启动目录影响
# ——用相对路径时从不同目录启动会在别处凭空建出一个空库，且不报错。
# 换 PostgreSQL 时取消注释（另需 pip install "psycopg[binary]"）：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ragkb

# --------------------------------------------------------------------------- 鉴权
# 留空则每次启动随机生成并打警告：进程重启后已签发的 token 全部失效（表现为需要重新登录）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --------------------------------------------------------------------------- 管理员（root）
# 刻意**不落 users 表**：注册流程既覆盖不了它，也抢注不了。
# 对外提供服务前务必改掉默认口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=管理员
# 是否允许 root 把「已通过审批」的用户提为管理员。设为 false 则系统中永远只有一个 root。
ALLOW_ADMIN_PROMOTION=true

# --------------------------------------------------------------------------- 对话模型（OpenAI 兼容）
# 经 langchain-openai 的 ChatOpenAI 调用，因此任何 OpenAI 兼容端点都能用
# （DeepSeek、vLLM、One-API、Ollama 的 /v1 等）。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# RAG 要的是忠实于材料，不是发挥，所以温度压低
LLM_TEMPERATURE=0.2

# --------------------------------------------------------------------------- LangSmith 追踪（可选）
# 打开后 LangGraph 的每个节点与模型调用都会上报，便于排查"为什么答成这样"
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-kb

# --------------------------------------------------------------------------- 嵌入
# ollama | openai | hash
#   ollama —— 本地常驻，需 `ollama serve` 且已 pull 对应模型
#   openai —— 任意 OpenAI 兼容的嵌入服务（用 EMBEDDING_BASE_URL / EMBEDDING_API_KEY）
#   hash   —— 确定性**伪**嵌入，仅用于在没有外部服务时跑通界面。
#             检索结果没有语义意义，/system/health 会标成 degraded。
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b
# 必须与嵌入模型的实际输出维度一致，否则写库时会被拒绝。
# 换模型必须同时改这里，并清空 document_chunks 重新入库。
EMBEDDING_DIM=2560
# 仅 EMBEDDING_PROVIDER=openai 时使用
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --------------------------------------------------------------------------- Redis（可选）
# 留空 = 不启用 Redis，全部走**进程内实现**：功能不缺失，只是不跨进程共享。
# 单进程部署（默认）这样完全够用。
#
# 什么时候必须配：**多实例 / 多进程部署**（uvicorn --workers N、k8s 多副本）。
# 进程内实现下，令牌吊销与登录限流只在处理该请求的那个进程里生效——
# 在 A 实例登出的令牌，B 实例仍然接受。这是"看起来正常、实则有安全缺口"
# 的情况，所以 /system/health 会把 Redis 状态显式报出来。
#
# 起一个本地 Redis：
#   docker run -d --name myrag-redis -p 6379:6379 redis:7-alpine
REDIS_URL=
# 同一台 Redis 上跑多个环境时用来隔离键名
REDIS_KEY_PREFIX=myrag
# 单次 Redis 操作超时。**保持很短**：Redis 抖动时不能把请求拖慢，
# 缓存的意义是加速，不是把故障传导给业务。
REDIS_SOCKET_TIMEOUT=1.0
# 查询向量缓存时长（秒）。默认 7 天。
# 查询向量是纯函数结果（同文本 + 同模型 = 同向量），所以可以给得很长。
EMBED_CACHE_TTL=604800

# 检索结果缓存时长（秒）。默认 120。
#
# **必须比 EMBED_CACHE_TTL 短得多**，因为检索结果依赖库里的内容，
# 而内容会变（上传 / 删除文档）。正确性主要由**语料版本号**保证——
# 每次文档变更都会 bump 版本号，所有检索缓存立即失效；
# 这个 TTL 只是兜底（万一有写入路径没覆盖到，最多脏这么久）。
#
# 为什么值得缓存：一次检索要读**全部**候选切片的向量。
# 实测 3000 切片 × 2560 维 = 7.3 MB、118ms；缓存命中 1.1ms（约 100 倍）。
SEARCH_CACHE_TTL=120

# --------------------------------------------------------------------------- 登录保护
# 登录失败次数上限与统计窗口。超过上限后锁定 LOGIN_LOCKOUT_SECONDS 秒。
#
# 这与"统一失败文案"是两件事：统一文案防的是**用户名枚举**，
# 防不住**口令爆破**（爆破者不在乎提示，只在乎能反复试）。
# 限流标识 = 用户名 + 来源 IP，避免共享出口（NAT）连累他人。
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300

# --------------------------------------------------------------------------- 可观测性
# 请求轨迹与模型用量采集。**数据只有管理员能看**（管理后台「观测」页）。
#
# 关掉时中间件直接透传，零开销——排查性能问题时不该让埋点本身成为变量。
OBSERVABILITY_ENABLED=true

# 轨迹保留天数。超期会被裁掉。
OBSERVABILITY_RETENTION_DAYS=7

# 轨迹表行数硬上限。**两道限制都要**：7 天的量在流量突增时也可能撑爆单机 SQLite。
OBSERVABILITY_MAX_ROWS=20000

# 写入队列容量。**满了会丢弃轨迹并计数**（不阻塞请求）——
# 观测数据是可丢弃的旁路信息，绝不能反压业务。
# 「丢弃」数会显示在观测页上，所以丢了不会被悄悄藏起来。
OBSERVABILITY_QUEUE_SIZE=2000

# --------------------------------------------------------------------------- 联网检索（Tavily，可选）
# 给攻略模式的 Researcher 用的联网能力。**默认是关的**，用户在界面上
# 点「允许联网」才触发。三个理由：
#   1. Tavily 按次计费，一次攻略要花 1~4 次检索；
#   2. 抓回来的网页是**外部不可信数据**，可能含提示注入；
#   3. 网上内容会变，同一问题的答案不再可复现。
#
# 申请 key：https://tavily.com
# 留空 = 不启用联网，界面上的按钮会显示"未配置"。
TAVILY_API_KEY=
# 服务端总开关。设为 false 则**所有用户**都不能联网（运维可整体禁用）。
WEB_SEARCH_ENABLED=true
# 每次检索取回的结果条数（上限 10）。给太大会把本地库资料挤出上下文。
TAVILY_MAX_RESULTS=5
# 单次联网超时（秒）。**保持短**：联网是锦上添花，不该把整轮攻略拖住。
TAVILY_TIMEOUT=8.0
# 每条网页摘要的截断长度。网页正文动辄几万字，全塞进去会挤掉本地资料。
WEB_SNIPPET_MAX_CHARS=1200

# --------------------------------------------------------------------------- 多轮追问记忆（Checkpointer）
# 攻略模式带 thread_id 的 LangGraph Checkpointer，让追问（「那换成水系呢」）
# 能读到上一轮的研究结论。
#
# **只给攻略模式加，对话模式不加**：对话模式已经从 qa_logs 重建历史，
# 再叠一层 checkpoint 会让消息二次增长（实测第 8 轮 56 条 vs 预期 14 条）。
#
# 数据库是 SQLite 时用 SqliteSaver（落 backend/data/checkpoints.db）；
# 换成 PostgreSQL 时自动退化为进程内 InMemorySaver 并记 warning
# ——功能不缺失，但重启后线程记忆会丢。
CHECKPOINT_ENABLED=true
# 保留的会话线程数上限。checkpoint 表只增不减，不设上限会慢慢撑大 SQLite。
CHECKPOINT_MAX_THREADS=500

# --------------------------------------------------------------------------- 上传
UPLOAD_MAX_MB=50

# --------------------------------------------------------------------------- 检索
TOP_K=4
MAX_HISTORY_ROUNDS=4

# --------------------------------------------------------------------------- 结构化输出
# function_calling | json_schema | json_mode
#
# **DeepSeek 不支持 json_schema**，会返回
#   400 This response_format type is unavailable now
# 而 LangChain 的默认值恰好就是 json_schema。这个错误不会中断流程——
# Planner / Researcher / Reviewer 三个节点会静默退化到兜底分支，
# 表现为「Planner 永远只拆一个单元、检索结论变成原文摘要」，
# 很容易被误判成模型能力问题。所以默认用 function_calling。
# 换成原生 OpenAI 端点时可以改成 json_schema（约束更严格）。
STRUCTURED_OUTPUT_METHOD=function_calling
